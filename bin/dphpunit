#!/bin/bash
# Customize the following:
containerName=$CONTAINER
phpunitPath=$REMOTE_PHPUNIT_BIN

# Detect local path and remove it from args
localPhpUnitResultPath='/tmp/phpunit-result.xml'
# Store all input arguments in an array
argsInput=${@}
runFile=$(echo $argsInput| awk '{print $1}')
phpTestPath=$(dirname "$runFile")
pushd $phpTestPath > /dev/null
projectPath="$(git rev-parse --show-toplevel)"
pushd > /dev/null

subPath=$(awk -F '/vendor/' '{print $1}' <<< $projectPath)
# containerName=$(sed 's#.*/##' <<< $subPath | sed s/-/_/g)

## detect test result output
for i in $argsInput; do
    case $i in
        --log-junit=*)
            outputPath="${i#*=}"
            ;;
        *)
            ;;
    esac
done

# # replace with local
# args=("${argsInput/$subPath\//}")
# args=("${args//(*}")

argsArray=("$@")
filteredArgs=()
log_junit_removed=0
for arg in "${argsArray[@]}"; do
    if [[ $log_junit_removed -eq 0 && $arg =~ ^--log-junit= ]]; then
        log_junit_removed=1
        continue
    fi
    filteredArgs+=("$arg")
done

# Replace with local path in filteredArgs
for i in "${!filteredArgs[@]}"; do
    filteredArgs[$i]="${filteredArgs[$i]/$subPath\//}"
done

# Remove any '(*' patterns (if needed)
for i in "${!filteredArgs[@]}"; do
    filteredArgs[$i]="${filteredArgs[$i]//(*}"
done

args=("${filteredArgs[@]}")

# Detect path
container=$(docker ps -n=-1 --filter name=$containerName --format="{{.ID}}")
phpunitPath=$(docker exec -it $container /bin/bash -c "if [ -f vendor/bin/phpunit ]; then echo vendor/bin/phpunit; else echo bin/phpunit; fi" | tr -d '\r')
execPath=$(docker exec -it $container /bin/bash -c "if [ -f /bin/sh ]; then echo /bin/sh; else echo /bin/bash; fi" | tr -d '\r')
dockerPath=$(docker inspect --format {{.Config.WorkingDir}} $container)

## debug
# echo "Raw ARGS: "${@}
# echo "Params:   "${args[@]}
# echo "Docker:   "$dockerPath
# echo "Local:    "$projectPath
# echo "Result:   "$outputPath
# echo docker exec -it "$container" "$execPath" -c "$(printf '%q ' SYMFONY_DEPRECATIONS_HELPER=weak "$phpunitPath" -d memory_limit=-1 -d xdebug.idekey=deliver-be "${args[@]}" --log-junit="${localPhpUnitResultPath}")"
# echo "docker exec -it $container $execPath -c \"SYMFONY_DEPRECATIONS_HELPER=weak $phpunitPath -d memory_limit=-1 -d xdebug.idekey=deliver-be ${args[@]} --log-junit=${localPhpUnitResultPath}\""

# Run the tests
docker exec -it "$container" "$execPath" -c "$(printf '%q ' SYMFONY_DEPRECATIONS_HELPER=weak "$phpunitPath" -d memory_limit=-1 -d xdebug.idekey=deliver-be "${args[@]}" --log-junit="${localPhpUnitResultPath}")"
# docker exec -it $container $execPath -c "SYMFONY_DEPRECATIONS_HELPER=weak $phpunitPath -d memory_limit=-1 -d xdebug.idekey=deliver-be ${args[@]} --log-junit=${localPhpUnitResultPath}"
# docker exec -it $container $phpunitPath -d memory_limit=-1 ${args[@]}

# copy results
docker cp -a "$container:$localPhpUnitResultPath" "$outputPath"|- &> /dev/null

# replace docker path to locals
# sed -i "s#$dockerPath#$projectPath#g" $outputPath
# sed -i '_' "s#$dockerPath#$projectPath#g" $outputPath
if [[ "$(uname)" == "Darwin" ]]; then
    sed -i '' "s#$dockerPath#$projectPath#g" "$outputPath"
else
    sed -i "s#$dockerPath#$projectPath#g" "$outputPath"
fi
